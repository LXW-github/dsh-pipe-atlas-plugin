{
  "name": "@local/dsh-pipe-atlas",
  "version": "1.2.0",
  "private": true,
  "description": "Pipe Atlas: an Ascend NPU execution-timeline panel in the Harness left sidebar",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "vendor/*",
    "scripts/*",
    "src/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "check": "node scripts/check.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LXW-github/dsh-pipe-atlas-plugin.git"
  },
  "homepage": "https://github.com/LXW-github/dsh-pipe-atlas-plugin#readme",
  "bugs": {
    "url": "https://github.com/LXW-github/dsh-pipe-atlas-plugin/issues"
  }
}
